# Run `npm run setup` to create `.env` with the proper values

# Server hostname/IP players connect to (printed after `npm start`)
# Not used by the server itself
SERVER_ADDRESS=
SERVER_PORT=25565

# Server timezone
TZ=UTC
# RAM allocation for the server
MEMORY=4G


# Minecraft server description
MOTD="My Home Minecraft server"
# Vanilla, Paper, Fabric, Forge, etc. Fabric is needed for the EasyAuth mod below
TYPE=FABRIC
# Server-side mods (Modrinth slugs), downloaded at startup. Players don't need them: vanilla clients can join.
# EasyAuth makes players set a password (/register) on first join and /login afterwards, since offline mode can't verify names
MODRINTH_PROJECTS=fabric-api,easyauth

# Minecraft game version. You can keep "LATEST" but it can auto update next time when you restart the server,
# So you can use specific version instead (e.g. 26.3). With mods, a new release can fail to start until the mods support it
VERSION=LATEST
# peaceful/easy/normal/hard
DIFFICULTY=normal
# survival/creative/adventure/spectator
MODE=survival
MAX_PLAYERS=5

# Lower values mean much less terrain to generate and simulate
#VIEW_DISTANCE=8
#SIMULATION_DISTANCE=6

# TRUE requires official Minecraft accounts. Switching setting resets player's progress.
# FALSE allows unofficial launchers like TLauncher
# When FALSE, OPS/WHITELIST entries need a `:offline` suffix (setup adds it) - it's not part of the in-game username
ONLINE_MODE=FALSE

# Admin rights for these usernames (comma-separated)
OPS=

# TRUE/FALSE, FALSE allows everyone to join
ENABLE_WHITELIST=
ENFORCE_WHITELIST=TRUE
# Whitelisted usernames (comma-separated)
WHITELIST=
